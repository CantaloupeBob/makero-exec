# PostgreSQL connection string consumed by `src/db/index.ts`.
DATABASE_URL=postgresql://user@localhost:5432/macro

# 32 raw bytes, base64-encoded (sodium ORIGINAL variant).
# Generate with: openssl rand -base64 32
# SECURITY:
#   • This key wraps every per-record DEK in `api_wallets`. If it is leaked,
#     the entire DB's worth of agent-wallet private keys is exposed.
#   • NEVER commit the real key. NEVER log it. Restrict file permissions
#     (`chmod 600 .env`) and prefer a KMS / secrets manager in production.
#   • Rotation: re-wrap each row's `encrypted_dek` with the new key (the
#     bulk `encrypted_private_key` ciphertext does not need to change).
MASTER_KEY=replace-me-with-output-of-openssl-rand-base64-32
MAX_ORDER_USDC=